---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
const entries = (await getCollection('kb', (e) => !e.data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---
<Base title="Knowledge Base · TheQMLGuy">
  <main class="prose">
    <a href="/" data-portal="/">← back to the avatar</a>
    <h1>Knowledge Base</h1>
    {entries.length === 0 ? (
      <p class="muted">Nothing here yet. The first entry is being written.</p>
    ) : (
      <ul>
        {entries.map((e) => (
          <li>
            <a href={`/knowledge-base/${e.id}`}>{e.data.title}</a>
            {e.data.summary && <span class="muted"> · {e.data.summary}</span>}
          </li>
        ))}
      </ul>
    )}
  </main>
</Base>
